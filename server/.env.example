# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # development | production

# ─────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_EXPIRE=7d                 # e.g. 7d, 30d
COOKIE_EXPIRE=7               # days

# ─────────────────────────────────────────────
# Frontend (used in password-reset emails)
# ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────
# Email  (Gmail SMTP / any nodemailer-compatible provider)
# ─────────────────────────────────────────────
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your_app_password

# ─────────────────────────────────────────────
# Cloudinary  (https://cloudinary.com)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────
# Seed script only  (never use real creds)
# ─────────────────────────────────────────────
ADMIN_EMAIL=admin@megahimalaya.com
ADMIN_PASSWORD=Admin@12345
